Функция ЗапросКоличестваСоСкладов (ТаблицаСоСкладами, Потребность)
	//Проверки
	Если Потребность <= 0 Тогда
		
		Сообщить("Потребность нулевая/меньше нуля.");
		Возврат Неопределено
		
	КонецЕсли;
	
	Если ТаблицаСоСкладами.количество() = 0 Тогда
		
		Сообщить("Входная таблица пустая.");
		Возврат Неопределено
		
	КонецЕсли;
	//конецПроверок

	Недопоставка = 0;
	КоличествоПотребности = Потребность;
	
	Результат = ТаблицаСоСкладами.Скопировать();
	Результат.колонки.Добавить("КОтгрузке",,"КОтгрузке");
	
	Для каждого ЭлементТаблицаСоСкладами Из ТаблицаСоСкладами Цикл
		
		КоличествоПотребности = КоличествоПотребности - 
		ЭлементТаблицаСоСкладами.Остаток;
		
		СтрокаРезультата = Результат.добавить();
		СтрокаРезультата.склад = ЭлементТаблицаСоСкладами.склад;
		СтрокаРезультата.остаток= ЭлементТаблицаСоСкладами.остаток;
		
		Если КоличествоПотребности <= 0  Тогда
			//если перегрузило 30 - 70 = -40 70 + (-40) = 30
			СтрокаРезультата.КОтгрузке = ЭлементТаблицаСоСкладами.Остаток + 
			КоличествоПотребности;
			Сообщить("Недопоставка = " + Недопоставка);
			Возврат Результат;
			
		Иначе
			СтрокаРезультата.КОтгрузке = ЭлементТаблицаСоСкладами.Остаток;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоПотребности > 0 Тогда
		
		
		Сообщить("Недопоставка = " + КоличествоПотребности);
		Возврат Результат;
		
	КонецЕсли;

КонецФункции // ()



