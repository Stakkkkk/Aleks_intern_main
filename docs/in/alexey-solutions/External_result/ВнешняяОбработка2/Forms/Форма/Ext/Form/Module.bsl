Функция НормализованныеКоды(КодыКНормализации)

	НормализованныеКоды = Новый ТаблицаЗначений;

	НормализованныеКоды.колонки.Добавить("Код",,"Код");
	НормализованныеКоды.колонки.Добавить("Количество",,"Количество");
	НормализованныеКоды.колонки.Добавить("ПерваяПозиция",,"ПерваяПозиция");
	НормализованныеКоды.колонки.Добавить("ЭтоДубль",,"ЭтоДубль");

	СоответствиеКоличества = новый Соответствие;
	соответсвтиеУникальности = новый Соответствие;

	Для Индекс = 0 По КодыКНормализации.ВГраница() Цикл

		ЭлементМассива = КодыКНормализации[Индекс];
		ЭлементМассива = СокрЛП(ЭлементМассива);

		Если ПустаяСтрока(ЭлементМассива) Тогда
			Продолжить;
		КонецЕсли;

		ключ = Врег(ЭлементМассива);
		ЗаписьСоответствия = СоответствиеКоличества.Получить(Ключ);
		Если ЗаписьСоответствия = неопределено тогда
			СоответствиеКоличества.вставить(ключ, 1);
		иначе
			СоответствиеКоличества.Вставить(Ключ, ЗаписьСоответствия + 1)
		конецесли;

		Если соответсвтиеУникальности.Получить(Ключ) = Неопределено  Тогда
			соответсвтиеУникальности.вставить(Ключ,Индекс); // индекс первая позиция
		конецЕсли

	КонецЦикла;

	Для каждого Элемента Из соответсвтиеУникальности Цикл

		стр = НормализованныеКоды.добавить();
		стр.код = Элемента.Ключ;
		стр.Количество = СоответствиеКоличества.Получить(Элемента.ключ);

		стр.ПерваяПозиция = Элемента.значение;

		стр.ЭтоДубль = (стр.количество > 1);

	КонецЦикла;

	возврат НормализованныеКоды;

КонецФункции

