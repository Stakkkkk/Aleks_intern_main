Функция ВозвратПервыхNстрок(Таблица, N)

	ЗаписейВИсходнойТаблице = Таблица.Количество();

	Если ЗаписейВИсходнойТаблице = 0 Тогда

		возврат ЗаписейВИсходнойТаблице;

	КонецЕсли;

	Если N <= 0 Тогда

		возврат Новый ТаблицаЗначений;

	КонецЕсли;

	Если N > ЗаписейВИсходнойТаблице Тогда

		N = таблица.количество();

	КонецЕсли;

	временнаяТаблица = таблица.скопировать();
	временнаяТаблица.Сортировать("Сумма Убыв, номенклатура");

