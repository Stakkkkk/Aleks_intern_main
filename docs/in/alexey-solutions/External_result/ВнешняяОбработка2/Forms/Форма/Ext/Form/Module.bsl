&НаКлиенте
Функция ЗаполнениеСтруктуры(ЗначениеПользователя)

	Узнавалка = Новый Структура;
	узнавалка.Вставить("Тип",ТипЗнч(ЗначениеПользователя) );
	узнавалка.Вставить("ЭтоНеопределено",ЗначениеПользователя = Неопределено );
	узнавалка.Вставить("ЭтоNull", ЗначениеПользователя = null );
	узнавалка.Вставить("Заполнено", ЗначениеЗаполнено(ЗначениеПользователя) );
	узнавалка.Вставить("Представление",Строка(ЗначениеПользователя) );

	Возврат Узнавалка;

КонецФункции // ЗаполнениеСтруктуры()

Функция УникальныеСтрокиИзМассива(Нашмассив)

	массивСорт = новый массив();

	СоответствиеСорт = новый Соответствие;
	Для Индекс = 0 По Нашмассив.ВГраница() Цикл
		текущийЭлемент = Нашмассив[Индекс];
		текущийЭлемент = СокрЛП(текущийЭлемент);
		Если ПустаяСтрока(ТекущийЭлемент) Тогда
			Продолжить;
		КонецЕсли;
		массив1 = СтрРазделить(текущийЭлемент, " ", Ложь);
		текущийЭлемент = СтрСоединить(массив1, " ");
		ключ = Нрег(текущийЭлемент);
		Если СоответствиеСорт.Получить(Ключ) = Неопределено  Тогда
			СоответствиеСорт.вставить(Ключ,Истина);
			массивСорт.Добавить(ТекущийЭлемент);
		КонецЕсли;
	КонецЦикла;

	Возврат массивСорт;

КонецФункции

&НаСервере
Функция ТаблицаПоДатам(ДатаНачала, ДатаОкончания)

	Если ДатаНачала > ДатаОкончания Тогда

		Сообщить("Ошибка: Дата начала не может быть раньше даты окончания!");
		Возврат Неопределено;
	КонецЕсли;

	ТаблицаДат = Новый ТаблицаЗначений;
	ТаблицаДат.Колонки.Добавить("Дата",,"Дата");//  Дата('2017.03.23 10:45:25')
	ТаблицаДат.Колонки.Добавить("ДеньНедели",,"ДеньНедели"); // пятница суббота
	ТаблицаДат.Колонки.Добавить("НачалоНедели",,"НачалоНедели");// начало недели 07.01.2026
	ТаблицаДат.Колонки.Добавить("НачалоМесяца",,"НачалоМесяца"); // начало месяца 01.01.2026
	ТаблицаДат.Колонки.Добавить("ЭтоВыходной", Новый ОписаниеТипов("Булево") ,"ЭтоВыходной"); // булевое

	ТекущаяДата = НачалоДня(ДатаНачала);

	СекундВСутках = 86400;

	Пока ТекущаяДата <= НачалоДня(ДатаОкончания) Цикл

		ДанныеДаты = ТаблицаДат.Добавить();
		ДанныеДаты.Дата 		= ТекущаяДата;
		ДанныеДаты.ДеньНедели 	= ДеньНедели(ТекущаяДата);
		ДанныеДаты.НачалоНедели = НачалоНедели(ТекущаяДата);
		ДанныеДаты.НачалоМесяца = НачалоМесяца(ТекущаяДата);

		Если ДанныеДаты.ДеньНедели = 6 ИЛИ  ДанныеДаты.ДеньНедели= 7 Тогда
			ДанныеДаты.ЭтоВыходной = "Да";
		Иначе
			ДанныеДаты.ЭтоВыходной = "Нет";
		КонецЕсли;

		ТекущаяДата = ТекущаяДата + СекундВСутках;

	КонецЦикла;

	Возврат ТаблицаДат;

КонецФункции

