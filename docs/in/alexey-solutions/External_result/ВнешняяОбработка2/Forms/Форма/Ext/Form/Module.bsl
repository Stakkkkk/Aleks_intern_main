Функция УпаковкаТовара(КоличествоТовара,ТовараВУпаковке)
	// на удивление лёгкая задача, мало ограничивающих условий.

	Если ТовараВУпаковке <= 0 Тогда
	
		Сообщить("Товара в упаковке не может быть меньше нуля, или равно нулю! ");
		Возврат Неопределено;
	
	КонецЕсли;
	
	ПолныхУпаковок = Цел(КоличествоТовара / ТовараВУпаковке);
	ОстатокТовара = КоличествоТовара % ТовараВУпаковке;
	ГрузовыхМест = ПолныхУпаковок;
	
	Если ОстатокТовара > 0 Тогда
	
		ГрузовыхМест = ГрузовыхМест+1
	
	КонецЕсли;

КонецФункции

