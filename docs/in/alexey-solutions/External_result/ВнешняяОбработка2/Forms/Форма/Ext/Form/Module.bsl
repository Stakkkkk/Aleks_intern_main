Функция РаспределитьОбщуюСуммуПоКоэффицентам (ТаблицаСКоэффицентами,ОбщаяСумма)

	// Проверки
	Если ОбщаяСумма < 0 Тогда
		
		Возврат неопределено
		
	КонецЕсли;
	
	ОбщаяСуммаКоэффицентов = 0;
	МаксимальныйКоэф = 0;
	ИндексСтрокиСМаксимальнымКоэф = 0;

	
	Для каждого ЭлементТаблицыКоэф Из ТаблицаСКоэффицентами Цикл
		
		Если ЭлементТаблицыКоэф.Коэффицент < 0 Тогда
			
			Возврат Неопределено
			
		КонецЕсли;
		
		ОбщаяСуммаКоэффицентов = ОбщаяСуммаКоэффицентов + ЭлементТаблицыКоэф.Коэффицент;
		
		Если ЭлементТаблицыКоэф.Коэффицент > МаксимальныйКоэф Тогда
			
			МаксимальныйКоэф = ЭлементТаблицыКоэф.Коэффицент;
			ИндексСтрокиСМаксимальнымКоэф = ТаблицаСКоэффицентами.Индекс(ЭлементТаблицыКоэф);
			// Получаем индекс строки с максимальным коэффицентом
			
		КонецЕсли;

	КонецЦикла;
	
	Если ОбщаяСуммаКоэффицентов < 0 Тогда
		
		Возврат неопределено
		
	КонецЕсли;
	//проверки пройдены
	
	ТаблицаСКоэффицентами.колонки.добавить("Распределено",,"Распределено");
	Доля = Окр(ОбщаяСумма / ОбщаяСуммаКоэффицентов,2);// доля на единицу коэффицента
	ОбщаяСуммаРаспределённыхПоКоэф = 0;  // переменная для проверки остатка
	
	Для каждого ЭлементИсходнойТаблицы Из ТаблицаСКоэффицентами Цикл
		
		ЭлементИсходнойТаблицы.Распределено = Доля * ЭлементИсходнойТаблицы.Коэффицент;
		ОбщаяСуммаРаспределённыхПоКоэф = ОбщаяСуммаРаспределённыхПоКоэф 
		+ ЭлементИсходнойТаблицы.Распределено;
		
		Если ТаблицаСКоэффицентами.Индекс(ЭлементТаблицыКоэф) = ИндексСтрокиСМаксимальнымКоэф Тогда
			
			ЭлементИсходнойТаблицы.Распределено = ЭлементИсходнойТаблицы.Распределено +
			общаяСумма - ОбщаяСуммаРаспределённыхПоКоэф;
			// если остаток при разности общей суммы есть, он находится и прибавляется к максимальному индексу
			
		КонецЕсли;
		
	КонецЦикла;
	

КонецФункции 


