Функция ВозвратПервыхNстрокТаблицы(ТаблицаВходная,N)
	
	Если ТаблицаВходная.Количество() = 0 Тогда
	
		возврат Null;
	
	КонецЕсли;
	
	Если N <= 0 Тогда
	
		возврат Новый ТаблицаЗначений;
	
	КонецЕсли;
	
	Если N > ТаблицаВходная.Количество() Тогда
	
		N = ТаблицаВходная.количество();
	
	КонецЕсли;
//  встроенная функция сортировки
	МестоВСортировке = 1;
	ОтсортированнаяТаблица = новый ТаблицаЗначений;
	ОтсортированнаяТаблица.Колонки.Добавить("Место",,"Место");
	ОтсортированнаяТаблица.Колонки.Добавить("Номенклатура",,"Номенклатура");
	ОтсортированнаяТаблица.Колонки.Добавить("Сумма",,"сумма");
	
	
	ВременнаяТаблицаКопияВходная = ТаблицаВходная.скопировать();
	ВременнаяТаблицаКопияВходная.Сортировать("Сумма Убыв, номенклатура");
	
	Для каждого ЭлементВременнаяТаблица Из ВременнаяТаблицаКопияВходная Цикл
	
		ЗаполнениеОтсортированнаяТаблица(ОтсортированнаяТаблица,МестоВСортировке,
		ЭлементВременнаяТаблица.Номенклатура,ЭлементВременнаяТаблица.Сумма);
		МестоВСортировке = МестоВСортировке + 1;
	КонецЦикла;
	
	Возврат ОтсортированнаяТаблица;

КонецФункции


