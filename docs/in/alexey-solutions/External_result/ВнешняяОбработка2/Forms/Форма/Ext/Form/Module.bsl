#Область Задача11

Функция ТаблицаВДревоЗначений (ИсходнаяТаблица)

	ДеревоКатегорий = Новый ДеревоЗначений;
	
	ДеревоКатегорий.Колонки.Добавить("Наименование",,"Наименование");
	ДеревоКатегорий.Колонки.Добавить("Сумма",,"Сумма");
	
	Для Каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл
		
		МассивРазделённыхЗначений = СтрРазделить(СтрокаТаблицы.Путь, "/");
		КоллекцияСтрок = ДеревоКатегорий.Строки;
		
		Для Каждого ЭлементМассива Из МассивРазделённыхЗначений Цикл

			Если ПустаяСтрока(ЭлементМассива) Тогда
			
				Продолжить;
				
			КонецЕсли;
			// если дерево пустое то флаг остаётся неопределено	
			НайденнаяСтрока = Неопределено;
			
			// цикл для проверки добавление новый ветки продажи -> онлайн -> сайт/маркетплейсы
			Для Каждого ВеткаДерева Из КоллекцияСтрок Цикл
				
				Если ВеткаДерева.Наименование = ЭлементМассива Тогда
					
					НайденнаяСтрока = ВеткаДерева;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			// если уже что то есть то добавляем в эту ветвь следующую
			Если НайденнаяСтрока = Неопределено Тогда
				
				НайденнаяСтрока = КоллекцияСтрок.Добавить();
				НайденнаяСтрока.Наименование = ЭлементМассива;
				НайденнаяСтрока.Сумма = 0;
			КонецЕсли;
			// строится лесенка дерева, 1 продажи -> 2 онлайн -> 3 сайт
			КоллекцияСтрок = НайденнаяСтрока.Строки;
			
		КонецЦикла;
		// добавление последнему звену суммы что бы дальше пойти верх по ветке 
		НайденнаяСтрока.Сумма = НайденнаяСтрока.Сумма + СтрокаТаблицы.Сумма;
		
	КонецЦикла;
	
	Для Каждого СтрокаДерева Из ДеревоКатегорий.Строки Цикл
		
		РассчитатьСумму(СтрокаДерева);
		
	КонецЦикла;
	
	Возврат ДеревоКатегорий;
	
КонецФункции
//рекурсивная функция
Функция РассчитатьСумму(СтрокаДерева)
	
	Для Каждого СтрокаВетка Из СтрокаДерева.Строки Цикл
		
		СтрокаДерева.Сумма = СтрокаДерева.Сумма + РассчитатьСумму(СтрокаВетка);
		
	КонецЦикла;
	
	Возврат СтрокаДерева.Сумма;
	
КонецФункции

