&НаКлиенте
Функция ЗаполнениеСтруктуры(ЗначениеПользователя)
	
	Узнавалка = Новый Структура;
	узнавалка.Вставить("Тип",ТипЗнч(ЗначениеПользователя) );
	узнавалка.Вставить("ЭтоНеопределено",ЗначениеПользователя = Неопределено );
	узнавалка.Вставить("ЭтоNull", ЗначениеПользователя = null );
	узнавалка.Вставить("Заполнено", ЗначениеЗаполнено(ЗначениеПользователя) );
	узнавалка.Вставить("Представление",Строка(ЗначениеПользователя) );
	
	Возврат Узнавалка;
	
КонецФункции // ЗаполнениеСтруктуры()

Функция УникальныеСтрокиИзМассива(Нашмассив)
	
	массивСорт = новый массив();
	
	СоответствиеСорт = новый Соответствие;
	Для Индекс = 0 По Нашмассив.ВГраница() Цикл
		текущийЭлемент = Нашмассив[Индекс];
		текущийЭлемент = СокрЛП(текущийЭлемент);
		Если ПустаяСтрока(ТекущийЭлемент) Тогда
			Продолжить;
		КонецЕсли;
		массив1 = СтрРазделить(текущийЭлемент, " ", Ложь);
		текущийЭлемент = СтрСоединить(массив1, " ");
		ключ = Нрег(текущийЭлемент);
		Если СоответствиеСорт.Получить(Ключ) = Неопределено  Тогда
			СоответствиеСорт.вставить(Ключ,Истина);
			массивСорт.Добавить(ТекущийЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат массивСорт;
	
КонецФункции


&НаСервере
Функция ПолучитьТаблицуЗначенийПоДатам(ДатаНачала, ДатаОкончания)

	ТаблицаЗначенийДата = Новый ТаблицаЗначений;
	
	ТаблицаЗначенийДата.Колонки.Добавить("Дата",,"Дата");//  Дата('2017.03.23 10:45:25')
	ТаблицаЗначенийДата.Колонки.Добавить("ДеньНедели",,"ДеньНедели"); // пятница суббота
	ТаблицаЗначенийДата.Колонки.Добавить("НачалоНедели",,"НачалоНедели");// начало недели 07.01.2026
	ТаблицаЗначенийДата.Колонки.Добавить("НачалоМесяца",,"НачалоМесяца"); // начало месяца 01.01.2026
	ТаблицаЗначенийДата.Колонки.Добавить("Выходной",,"Выходной"); // булевое
	
	// ДеньНедели
	// НачалоПериода
	
	Если ДатаНачала > ДатаОкончания Тогда
	
		Сообщить("Ошибка: Дата начала не может быть раньше даты окончания!");
		возврат Null; 
	
	Иначе
		ТекущаяДата = НачалоДня(ДатаНачала);
		Пока ТекущаяДата <= НачалоДня(ДатаОкончания) Цикл
		
		Стр = ТаблицаЗначенийДата.Добавить();
		стр.Дата = ТекущаяДата;
		стр.ДеньНедели = ДеньНедели(ТекущаяДата);
		стр.НачалоНедели = НачалоНедели(ТекущаяДата);
		стр.НачалоМесяца = НачалоМесяца(ТекущаяДата);
		
		Если стр.ДеньНедели = 6 ИЛИ  стр.ДеньНедели= 7 Тогда
			стр.Выходной = "Да";
		Иначе
			стр.Выходной = "Нет";
			
		КонецЕсли;
		ТекущаяДата = ТекущаяДата + 86400;
		
		КонецЦикла;

		

		возврат ТаблицаЗначенийДата;
	
	КонецЕсли;


КонецФункции // ПолучитьТаблицуЗначенийПоДатам()

&НаСервере
Функция НормализироватьМассив(ВходнойМассив)
	
	ТаблицаЗначенийМассив = новый ТаблицаЗначений;
	
	ТаблицаЗначенийМассив.колонки.Добавить("Код",,"Код");
	ТаблицаЗначенийМассив.колонки.Добавить("Количество",,"Количество");
	ТаблицаЗначенийМассив.колонки.Добавить("ПерваяПозиция",,"ПерваяПозиция");
	ТаблицаЗначенийМассив.колонки.Добавить("ЭтоДубль",,"ЭтоДубль");
	
	СоответствиеКоличества = новый Соответствие;
	соответсвтиеУникальности = новый Соответствие;
	
	Для Индекс = 0 По ВходнойМассив.ВГраница() Цикл
	
		ЭлементМассива = ВходнойМассив[Индекс];
		ЭлементМассива = СокрЛП(ЭлементМассива);
		Если ПустаяСтрока(ЭлементМассива) Тогда
			Продолжить;
		КонецЕсли;
		ключ = Врег(ЭлементМассива);
		Если СоответствиеКоличества.Получить(Ключ) = неопределено тогда
			СоответствиеКоличества.вставить(ключ,1);
		иначе
			СоответствиеКоличества.Вставить(Ключ,СоответствиеКоличества.получить(ключ) + 1)
		конецесли;
		
		Если соответсвтиеУникальности.Получить(Ключ) = Неопределено  Тогда
			соответсвтиеУникальности.вставить(Ключ,Индекс); // индекс первая позиция
		конецЕсли
		
	КонецЦикла;
	
	

	Для каждого Элемента Из соответсвтиеУникальности Цикл
		

		стр = ТаблицаЗначенийМассив.добавить();
		стр.код = Элемента.Ключ;
		стр.Количество = СоответствиеКоличества.Получить(Элемента.ключ);

		стр.ПерваяПозиция = Элемента.значение;
		
		Если стр.количество > 1 Тогда
		
			стр.ЭтоДубль = Истина;
		
		Иначе
		
			Стр.ЭтоДубль = ложь;
		
		КонецЕсли;
	КонецЦикла;
	
возврат ТаблицаЗначенийМассив;

КонецФункции 

Функция СводСтрокЗаказа(Таблица)

	ТаблицаСортировка = Новый ТаблицаЗначений;
	ТаблицаСортировка.Колонки.добавить("Номенклатура",,"Номенклатура");
	ТаблицаСортировка.Колонки.добавить("Склад",,"Склад");
	ТаблицаСортировка.Колонки.добавить("Количество",,"Количество");
	ТаблицаСортировка.Колонки.добавить("Сумма",,"Сумма");
	
	СоответствиеКлючей= новый соответствие;
	
	Для каждого Элемент Из Таблица Цикл
		
		ключ = строка(Элемент.Номенклатура) + строка(Элемент.Склад); //идея - сложить 2 строки и получить 1 строку - ключ
		
		Если СоответствиеКлючей.Получить(Ключ) = неопределено Тогда
			
			стр = ТаблицаСортировка.добавить(); // добавляем если новый ключ
			стр.номенклатура = Элемент.номенклатура;
			стр.склад = Элемент.склад;
			стр.количество = Элемент.количество;
			стр.сумма = Элемент.количество * Элемент.цена;
			
			СоответствиеКлючей.Вставить(Ключ,стр); // сохраняется ссылка на строку
		Иначе
			
			СуществующаяСтрока = СоответствиеКлючей.получить(ключ);
			СуществующаяСтрока.Количество = СуществующаяСтрока.Количество + Элемент.количесиво;
			СуществующаяСтрока.сумма = СуществующаяСтрока.сумма + Элемент.сумма;
			
		КонецЕсли;
	КонецЦикла;
	
	возврат ТаблицаСортировка;

КонецФункции // СводСтрокЗаказа()


Функция ПоискОшибокВТаблица(Таблица,КонтрольнаяДата)
// Одно большое или нельзя сделать только 1 ошибку найдёт
// может сделать флаги на каждую возможную ошибку и в конце цикла проверки их снова Ложь делать?
	

	ТаблицаСОшибками = Новый ТаблицаЗначений;
	ТаблицаСОшибками.Колонки.Добавить("НомерСтроки",,"НомерСтроки");
	ТаблицаСОшибками.Колонки.Добавить("Поле",,"Поле");
	ТаблицаСОшибками.Колонки.Добавить("КодОшибки",,"КодОшибки");
	ТаблицаСОшибками.Колонки.Добавить("ТекстОшибки",,"ТекстОшибки");

	Для каждого Элемент Из Таблица Цикл
		стр = ТаблицаСОшибками.Добавить(); // даже при 0 ошибок таблица возвращается
		
		Если Элемент.Номенклатура = неопределено Тогда
			
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " Номенклатура ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаНоменклатура ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " номенклатура не заполнена ";
			
		КонецЕсли;
		
		Если ТипЗнч(Элемент.количество) <> ТипЗнч(10) Тогда
		
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " количество ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаТипаКоличество ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " поле количество не тип число ";
			
		КонецЕсли;
		
		Если Элемент.количество <= 0 Тогда
			
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " количество ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаКоличество ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " количество не больше нуля ";
			
		КонецЕсли;
		Если ТипЗнч(Элемент.Цена) <> ТипЗнч(10) Тогда
			
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " цена ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаТипаЦена ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " поле цена не тип число ";
			
		КонецЕсли;
		
		Если Элемент.цена < 0 Тогда
			
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " цена ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаЦена ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " цена меньше нуля ";
			
		КонецЕсли;
		
		Если ТипЗнч(Элемент.ДатаОтгрузки) <> ТипЗнч('2025.10.10') Тогда
			
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " ДатаОтгрузки ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаТипаДатаОтгрузки ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " поле ДатаОтгрузки не тип дата ";
			
		КонецЕсли;
		Если Элемент.ДатаОтгрузки < КонтрольнаяДата Тогда
			
			стр.НомерСтроки = Элемент.НомерСтроки;
			стр.Поле = Строка(стр.поле) + " ДатаОтгрузки ";
			стр.КодОшибки = Строка(стр.кодОшибки) + " ОшибкаДатаОтгрузки ";
			стр.ТекстОшибки = Строка(стр.ТекстОшибки) + " дата отгрузки раньше контрольной даты";
			
		КонецЕсли;
	КонецЦикла;
	возврат ТаблицаСОшибками;
КонецФункции // ПоискОшибокВТаблица()

